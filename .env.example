# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your key never leaves this machine.
# No quotes around values.

ANTHROPIC_API_KEY=paste-your-key-here

# Cheapest current Claude model, to stretch a small budget during development
LLM_DEFAULT_MODEL=claude-haiku-5-5

# Hard stop: the app refuses LLM calls once this much has been spent (USD)
LLM_BUDGET_USD=4.00

DATABASE_URL=postgresql://mediflow:mediflow@db:5432/mediflow
COORDINATOR_ENABLED=true
RAG_MIN_SIMILARITY=0.50
SIM_NHIS_URL=http://sim_nhis:8001
DEMO_MODE=true
